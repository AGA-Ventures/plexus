PLEXUS_PUBLIC_WHATSAPP_DISPLAY=+60 12-345 6789

# Server-only meeting provider credentials.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
PLEXUS_DEFAULT_MEETING_PROVIDER=zoom
LARK_APP_ID=
LARK_APP_SECRET=
