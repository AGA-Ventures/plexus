# Server-only. Prefer the Supabase sb_secret_... key. The service-role variable
# remains supported for existing deployments. Never prefix either with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only email delivery. The From value is not secret; provider and
# signing credentials must be stored as sensitive environment variables.
PLEXUS_EMAIL_FROM="Plexus <notifications@info.plexus.enterprises>"
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
CRON_SECRET=

# Used only by `npm run bootstrap:superadmin`; never commit real values.
