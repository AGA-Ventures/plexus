{
  "name": "plexus-connect-demo",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "packageManager": "npm@11.12.0",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "bootstrap:superadmin": "node --env-file=.env.local scripts/bootstrap-superadmin.mjs",
    "deploy:preview": "node scripts/deploy-vercel.mjs preview",
    "deploy:production": "node scripts/deploy-vercel.mjs production",
    "docs:check": "node scripts/check-docs.mjs",
    "start": "next start",
    "lint": "eslint",
    "setup:repo": "node scripts/setup-repository.mjs",
    "supabase:login": "supabase login",
    "supabase:link": "supabase link --project-ref pnjblggcdigekluualin",
    "supabase:plan": "node scripts/deploy-supabase.mjs plan",
    "supabase:push": "node scripts/deploy-supabase.mjs apply",
    "supabase:advisors": "node scripts/verify-deployment-targets.mjs --require-supabase-link && supabase db advisors --linked --type all --fail-on error",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:rls": "supabase test db",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "verify:deploy": "node scripts/verify-vercel-targets.mjs",
    "verify:release": "npm run verify:targets && npm run docs:check && npm audit --omit=dev --audit-level=critical && npm run lint && npm run typecheck && npm run test:unit && npm run build",
    "verify:targets": "node scripts/verify-deployment-targets.mjs",
    "whereami": "node scripts/where-am-i.mjs"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.2.1",
    "@hugeicons/react": "^1.1.7",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "4.15.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "supabase": "2.109.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
